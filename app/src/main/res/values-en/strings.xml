    <!-- Legal & Support -->
    <string name="settings_item_privacy">Privacy Policy</string>
    <string name="settings_item_terms">Terms of Use</string>
    <string name="legal_screen_title">Legal &amp; Privacy</string>
    <string name="legal_tab_privacy">Privacy</string>
    <string name="legal_tab_terms">Terms of Use</string>
    <string name="legal_last_updated_date">September 2026</string>
    <string name="legal_badge_updated">Updated: %1$s</string>
    <string name="legal_badge_compliance">Data Protection</string>
    <string name="legal_privacy_commitment_title">Privacy Commitment</string>
    <string name="legal_privacy_commitment_desc">At Rinde we take your privacy seriously. We do not sell your personal data or shopping lists to third parties. You have complete control over your account and can delete it at any time.</string>
    <string name="legal_privacy_sec1_title">Information We Collect</string>
    <string name="legal_privacy_sec1_content">• Account Details: Public name or alias, email address, and optional profile photo.\n• Community Posts: Details of deals you voluntarily share (title, price, description, store or branch, and photo).\n• Community Interactions: Deal votes (True or False), comments, saved deals, and community reports.\n• Lists and Goals: Shopping list names, products, quantities, and savings goals for synchronization and review.\n• General Diagnostics: Anonymous crash reports to guarantee app stability.</string>
    <string name="legal_privacy_sec2_title">Use of Information</string>
    <string name="legal_privacy_sec2_content">Information is used exclusively to:\n1. Manage and synchronize your shopping lists and savings goals.\n2. Display and share deals in the community, as well as record votes and opinions.\n3. Maintain session security and prevent abuse on the platform.\n\nRinde does NOT sell, rent, or trade your personal data or shopping habits with third-party advertising companies.</string>
    <string name="legal_privacy_sec3_title">Device Permissions</string>
    <string name="legal_privacy_sec3_content">• Location: Enables finding and showing nearby stores or branches when browsing or posting local deals.\n• Gallery / Photos: Allows selecting images from your device to illustrate deals or update your profile picture.\n• Notifications: To notify you of relevant updates, featured deals, or community activity if you enable them.\n• Internet Access: Required to synchronize your lists, goals, and community deals in real time.</string>
    <string name="legal_privacy_sec4_title">Security &amp; Data Protection</string>
    <string name="legal_privacy_sec4_content">All information is transmitted and stored through protected channels using modern security and encryption protocols. We enforce strict measures to safeguard your information against unauthorized access, loss, or alteration.</string>
    <string name="legal_privacy_sec5_title">Storage on Your Device</string>
    <string name="legal_privacy_sec5_content">Your lists and preferences are stored privately and securely on your own device, providing fast access while ensuring only you control your personal information.</string>
    <string name="legal_privacy_sec6_title">Your Rights &amp; Account Deletion</string>
    <string name="legal_privacy_sec6_content">You have full control over your personal data:\n• Editing: You can update your details or profile picture at any time from Edit Profile.\n• Permanent Deletion: You can permanently delete your account from \'Profile > Edit Profile > Delete Account\'. Once confirmed, your user, lists, and associated data will be irreversibly removed from our systems.</string>
    <string name="legal_privacy_sec7_title">Privacy Contact</string>
    <string name="legal_privacy_sec7_content">For any questions or exercising your privacy rights:\n• Support email: soporte@rinde.app / farbalapps1993@gmail.com\n• Developer: FarbalApps\n• Website: https://rinde.app</string>

    <string name="legal_terms_badge_tag">Official Terms of Use</string>
    <string name="legal_terms_notice_title">Notice on Prices and Deals</string>
    <string name="legal_terms_notice_desc">Rinde is a collaborative community platform. We are not a store and do not sell products directly. Prices and deals belong to external stores and may vary or expire without notice.</string>
    <string name="legal_terms_sec1_title">Nature of Service &amp; Disclaimer</string>
    <string name="legal_terms_sec1_content">• Rinde does not set prices or guarantee the availability of items in physical or online stores.\n• All purchases are conducted directly between the user and the merchant.\n• Rinde assumes no liability for price differences, out-of-stock items, or merchant claims.</string>
    <string name="legal_terms_sec2_title">Community Guidelines</string>
    <string name="legal_terms_sec2_content">It is strictly prohibited to:\n1. Post fake, deceptive deals or fraudulent links.\n2. Share unlawful, harmful, or inappropriate content.\n3. Post commercial spam or manipulate veracity votes.\n4. Post defamatory or aggressive comments.\n\nModeration: The community uses \'True/False\' votes and reports. Rinde reserves the right to remove posts or restrict offending accounts without notice.</string>
    <string name="legal_terms_sec3_title">Permitted Use &amp; Restrictions</string>
    <string name="legal_terms_sec3_content">It is prohibited to attempt to breach security measures, decompile the application, or use automated tools to extract data without explicit consent.</string>
    <string name="legal_terms_sec4_title">Intellectual Property</string>
    <string name="legal_terms_sec4_content">The Rinde brand, logo, UI design, and source code are property of FarbalApps.\n\nTrademarks, trade names, and logos of stores or products shown in deals belong to their respective owners and are used purely for informative and referential purposes.</string>
    <string name="legal_terms_sec5_title">Service Availability</string>
    <string name="legal_terms_sec5_content">The application is provided \'as is\'. Rinde is not liable for temporary service interruptions caused by device or network connectivity problems.</string>
    <string name="legal_terms_sec6_title">Modifications to Terms</string>
    <string name="legal_terms_sec6_content">We reserve the right to update these terms to incorporate app improvements or satisfy regulatory changes. The date of the last update will always be visible in this section.</string>
    <string name="legal_terms_sec7_title">Applicable Law &amp; Jurisdiction</string>
    <string name="legal_terms_sec7_content">These terms are governed by applicable electronic commerce and data protection laws. Any dispute will be submitted to the competent authorities and courts.</string>

